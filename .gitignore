# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/

# ------------------------------------------------------- крупные артефакты
# корпус объектов пересоздаётся скриптом (python -m hdoe.corpus)
data/corpus.npy
# z-стопки дашборда пересобираются build_dashboard.py
dashboard/data/*.bin
# ВНИМАНИЕ: dashboard/data_bundle.js НЕ игнорируется — он нужен для открытия
# index.html двойным кликом (офлайн-режим, п. 12.1 ТЗ).

# служебное
tools/node_modules/
experiments/_preview/
# снапшоты маски обучения нужны для панели 7 дашборда (8 файлов × 16 КБ)
outputs/_*.npy
experiments/_*.npy

# комплекты, принесённые пользователем через дашборд (id — метка времени),
# и копия сдаваемого набора, которую сервер готовит сам при старте
data/sets/2*/
data/sets/default/
outputs/_cache/

# служебное
.DS_Store
*.log
experiments/out/

# промежуточные чекпоинты обучения (генерируются train_gpu.py / train.py);
# единственный сдаваемый чекпоинт — outputs/best.pt
outputs/distilled.pt
outputs/teacher_masks.pt
